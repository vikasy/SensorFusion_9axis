    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug 9-axis Sensor Fusion",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/SensorFusion",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake-build-9axis",
            "miDebuggerPath": "/usr/bin/lldb-mi",
            "logging": {
                "moduleLoad": false,
                "trace": false,
                "engineLogging": false,
                "programOutput": true,
                "exceptions": true
            }
        },
